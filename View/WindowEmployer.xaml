<Window x:Class="VizProgLaba1._1.View.WindowEmployer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники"
        Height="350"
        Width="700">

    <StackPanel>


        <StackPanel Orientation="Horizontal"
            Background="#FFE4E0E0">

            <Button Content="Добавить"
            Width="100"
            Height="25"
            Margin="5"
            Command="{Binding AddPerson}"/>

            <Button Content="Редактировать"
            Width="115"
            Height="25"
            Margin="5"
            Command="{Binding EditPerson}"/>

            <Button Content="Удалить"
            Width="100"
            Height="25"
            Margin="5"
            Command="{Binding DeletePerson}"/>

        </StackPanel>


        <ListView x:Name="lvEmployee"
                  ItemsSource="{Binding ListPersonDpo}"
                  SelectedItem="{Binding SelectedPersonDpo, Mode=TwoWay}">

            <ListView.View>
                <GridView>

                    <GridViewColumn Header="Код"
                                    Width="50"
                                    DisplayMemberBinding="{Binding Id}"/>

                    <GridViewColumn Header="Фамилия"
                                    Width="120"
                                    DisplayMemberBinding="{Binding LastName}"/>

                    <GridViewColumn Header="Имя"
                                    Width="100"
                                    DisplayMemberBinding="{Binding FirstName}"/>

                    <GridViewColumn Header="Должность"
                                    Width="170"
                                    DisplayMemberBinding="{Binding RoleName}"/>

                    <GridViewColumn Header="Дата рождения"
                                    Width="120"
                                    DisplayMemberBinding="{Binding Birthday, StringFormat=dd.MM.yyyy}"/>

                </GridView>
            </ListView.View>

        </ListView>

    </StackPanel>
</Window>
