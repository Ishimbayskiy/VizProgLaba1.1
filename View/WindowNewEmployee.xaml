<Window x:Class="VizProgLaba1._1.View.WindowNewEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый сотрудник" Height="380" Width="450"
        Language="ru-RU" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Код сотрудника:" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Person.Id}" Margin="5" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="Фамилия:" VerticalAlignment="Center"/>
        <TextBox x:Name="tbLastName" Grid.Row="1" Grid.Column="1" Height="25" Margin="5"
                 Text="{Binding Person.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="2" Text="Имя:" VerticalAlignment="Center"/>
        <TextBox x:Name="tbFirstName" Grid.Row="2" Grid.Column="1" Height="25" Margin="5"
                 Text="{Binding Person.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="3" Text="Должность:" VerticalAlignment="Center"/>
        <ComboBox x:Name="CbRole" Grid.Row="3" Grid.Column="1" Height="25" Margin="5"
                  ItemsSource="{Binding ListRole}" DisplayMemberPath="NameRole" SelectedValuePath="NameRole"
                  SelectedValue="{Binding Person.RoleName, Mode=TwoWay}"/>
        <TextBlock Grid.Row="4" Text="Дата рождения:" VerticalAlignment="Center"/>
        <TextBox x:Name="tbBirthday" Style="{StaticResource TextBoxDate}"
                 Text="{Binding Person.Birthday, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="4" Grid.Column="1" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="5,8,0,7" Width="130" IsVisibleChanged="tbBirthday_IsVisibleChanged"/>
        <DatePicker x:Name="ClBirthday" Visibility="Hidden" Grid.Row="4" Grid.Column="1"
                    SelectedDate="{Binding Person.Birthday, StringFormat={}{0:dd\.}{0:MM\.}{0:yyyy}, ConverterCulture=ru-RU, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,8,0,7" Width="130"/>
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Height="30" Margin="5" IsDefault="True"
                    Command="{Binding Save}" CommandParameter="{Binding SelectedItem, ElementName=CbRole}"/>
            <Button Content="Отмена" Width="100" Height="30" Margin="5" IsCancel="True" Command="{Binding Cancel}"/>
        </StackPanel>
    </Grid>
</Window>
