<Window x:Class="VizProgLaba1._1.View.WindowNewEmployee"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый сотрудник"
        Height="380"
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="15">

        <TextBlock Text="Код сотрудника:"/>

        <TextBlock Text="{Binding Person.Id}"
                   Margin="0,5,0,10"/>

        <TextBlock Text="Фамилия:"/>

        <TextBox x:Name="tbLastName"
                 Height="25"
                 Margin="0,5,0,10"
                 Text="{Binding Person.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Имя:"/>

        <TextBox x:Name="tbFirstName"
                 Height="25"
                 Margin="0,5,0,10"
                 Text="{Binding Person.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="Должность:"/>

        <ComboBox x:Name="CbRole"
                  Height="25"
                  Margin="0,5,0,10"
                  ItemsSource="{Binding ListRole}"
                  DisplayMemberPath="NameRole"
                  SelectedValuePath="NameRole"
                  SelectedValue="{Binding Person.RoleName, Mode=TwoWay}"/>

        <TextBlock Text="Дата рождения:"/>

        <DatePicker x:Name="dpBirthday"
                    Height="30"
                    Margin="0,5,0,10"
                    SelectedDate="{Binding Person.Birthday, Mode=TwoWay}"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Сохранить"
                    Width="100"
                    Height="30"
                    Margin="5"
                    IsDefault="True"
                    Command="{Binding Save}"/>

            <Button Content="Отмена"
                    Width="100"
                    Height="30"
                    Margin="5"
                    IsCancel="True"
                    Command="{Binding Cancel}"/>

        </StackPanel>

    </StackPanel>
</Window>
